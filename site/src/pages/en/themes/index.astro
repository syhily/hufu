---
import Base from '@/layouts/Base.astro';

const meta = {
  title: "Themes · Hufu",
  description: "Explore palettes and make them your own. Preview and edit in your browser, then click to install in Hufu.",
};
const copy = {"encoding": "Cannot decode this share link. Check the complete link or choose a built-in theme to start again.", "size": "Theme exceeds 4096 bytes. Shorten its name or author.", "format": "Unsupported theme format. Choose a built-in theme to start again.", "version": "Unsupported theme version. Choose a built-in theme to start again.", "id": "Use 2–32 lowercase letters, digits or underscores for the ID, starting with a letter.", "reserved": "hufu_custom is reserved. Choose another theme ID.", "builtin": "This ID belongs to a built-in theme; Hufu would ignore color edits. Use a new ID.", "name": "Name must contain 1–40 characters after removing control characters.", "author": "Author must contain 1–40 characters, or be left blank.", "layout": "Correct the layout values using numbers within the indicated ranges.", "colors": "Correct the marked color value. Use 0xAARRGGBB or #RRGGBB.", "copied": "Copied", "clipboard": "Clipboard unavailable. Copy the selected text manually.", "lowContrast": "Low contrast", "contrast": "Contrast", "history": "The browser could not update the URL; you can still copy a share link.", "storage": "Local storage is unavailable. Copy a share link to save your theme.", "themeCount": "themes"};
---

