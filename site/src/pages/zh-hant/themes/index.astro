---
import Base from '@/layouts/Base.astro';

const meta = {
  title: "主題 · Hufu",
  description: "8 套配色，都是 App 實際渲染。點「安裝到 Hufu」由設定確認匯入，也可以複製 YAML 手動加入配置。",
};
const copy = {"encoding": "分享連結無法解碼，請檢查完整連結，或選擇內建主題重新開始。", "size": "主題超過 4096 位元組，請縮短名稱或作者。", "format": "主題格式不受支援，請選擇內建主題重新開始。", "version": "主題版本不受支援，請選擇內建主題重新開始。", "id": "主題標識須為 2–32 位小寫字母、數字或下劃線，並以字母開頭。", "reserved": "hufu_custom 為保留標識，請換一個主題標識。", "builtin": "此標識屬於內建主題，App 會忽略改色。請使用新的主題標識。", "name": "名稱去掉控制字元後須為 1–40 個字元。", "author": "作者須為 1–40 個字元，或留空。", "layout": "請修正佈局數值，使用標註範圍內的數字。", "colors": "請修正標紅色值，格式為 0xAARRGGBB 或 #RRGGBB。", "copied": "已複製", "clipboard": "瀏覽器不允許複製，請手動複製已選中的內容。", "lowContrast": "對比度偏低", "contrast": "對比度", "history": "瀏覽器無法更新連結；仍可複製分享連結。", "storage": "本地儲存不可用，請複製分享連結儲存配色。", "themeCount": "款配色"};
