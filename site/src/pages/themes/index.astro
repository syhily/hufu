const copy = {"encoding": "分享链接无法解码，请检查完整链接，或选择内置主题重新开始。", "size": "主题超过 4096 字节，请缩短名称或作者。", "format": "主题格式不受支持，请选择内置主题重新开始。", "version": "主题版本不受支持，请选择内置主题重新开始。", "id": "主题标识须为 2–32 位小写字母、数字或下划线，并以字母开头。", "reserved": "hufu_custom 为保留标识，请换一个主题标识。", "builtin": "此标识属于内置主题，App 会忽略改色。请使用新的主题标识。", "name": "名称去掉控制字符后须为 1–40 个字符。", "author": "作者须为 1–40 个字符，或留空。", "layout": "请修正布局数值，使用标注范围内的数字。", "colors": "请修正标红色值，格式为 0xAARRGGBB 或 #RRGGBB。", "copied": "已复制", "clipboard": "浏览器不允许复制，请手动复制已选中的内容。", "lowContrast": "对比度偏低", "contrast": "对比度", "history": "浏览器无法更新链接；仍可复制分享链接。", "storage": "本地存储不可用，请复制分享链接保存配色。", "themeCount": "款配色"};
