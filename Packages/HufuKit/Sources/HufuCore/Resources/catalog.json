      "max": 20
    },
    {
      "id": "appearance.spacing",
      "group": "appearance",
      "title": "候选间距",
      "description": "横排模式下相邻候选之间的间距（点）。",
      "file": "frontend",
      "keypath": "style/hufu/spacing",
      "type": "double",
